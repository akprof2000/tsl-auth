# Скопируйте в .env и заполните.

# Мастер-ключ шифрования данных (base64, 32 байта). ОДИН на все экземпляры, храните резервную копию!
# Сгенерировать:  openssl rand -base64 32
#   или PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
ENCRYPTION_MASTER_KEY=

POSTGRES_PASSWORD=change-me
# Внешний PostgreSQL (тогда сервис postgres в compose можно удалить):
# DB_CONNECTION_STRING=Host=db.local;Port=5432;Database=tsl_auth;Username=tsl_auth;Password=...

# Публичный адрес сервиса (одинаковый для всех экземпляров — это iss в токенах)
AUTH_ISSUER=http://localhost:8080/
AUTH_REQUIRE_HTTPS=false
AUTH_PORT=8080

# Первый администратор. Если пароль пуст — будет сгенерирован одноразовый и выведен в лог.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Необязательно: клиент для внешнего Admin API (client_credentials, scope tsl-auth-admin)
BOOTSTRAP_API_CLIENT_ID=
BOOTSTRAP_API_CLIENT_SECRET=

# Внутренний SMTP (приглашения и сброс пароля). Пусто — ссылки выдаются в админке.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURITY=None
SMTP_FROM=TSL Auth <no-reply@tsl.local>
