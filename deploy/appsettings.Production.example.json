{
  "_comment": "Пример настроек файлом вместо переменных окружения. Смонтируйте в контейнер как /app/appsettings.Production.json (накладывается на встроенный appsettings.json — достаточно указать изменяемые ключи) или задайте путь переменной APPSETTINGS_PATH. Переменные окружения имеют приоритет над файлом; уровни логирования из настроек в БД — над всем. Все ключи: docs/configuration.md.",

  "Database": {
    "Provider": "Postgres",
    "ConnectionStringFile": "/run/secrets/db_connection_string"
  },

  "Encryption": {
    "MasterKeyFile": "/run/secrets/master_key"
  },

  "Auth": {
    "Issuer": "https://auth.corp/",
    "RequireHttps": true,
    "TrustForwardedHeaders": true,
    "KnownNetworks": "172.30.0.0/16"
  },

  "AllowedHosts": "auth.corp",

  "Bootstrap": {
    "AdminUserName": "admin",
    "AdminPasswordFile": "/run/secrets/admin_password"
  },

  "Smtp": {
    "Host": "smtp.corp",
    "Port": 25,
    "Security": "None",
    "From": "TSL Auth <no-reply@corp>"
  },

  "Logging": {
    "Format": "Json",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning",
      "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
    },
    "File": {
      "Path": "/app/data/logs/tsl-auth-.log",
      "SizeLimitMb": 20,
      "RetainedFiles": 5,
      "Compress": true
    }
  },

  "Observability": {
    "ServiceName": "tsl-auth",
    "ResourceAttributes": "deployment.environment=prod",
    "Prometheus": {
      "Enabled": true,
      "AllowedNetworks": "10.0.0.0/8",
      "TokenFile": "/run/secrets/metrics_token"
    },
    "OpenTelemetry": {
      "Endpoint": "http://otel-collector:4317",
      "Protocol": "grpc",
      "Traces": true,
      "Metrics": false,
      "Logs": false,
      "TraceSamplingRatio": 0.2
    },
    "Loki": {
      "Url": "http://loki:3100",
      "Labels": "env=prod",
      "MinimumLevel": "Information"
    }
  }
}
