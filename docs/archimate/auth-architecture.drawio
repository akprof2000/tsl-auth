ashed=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v17" target="p2v10" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e51" value="" style="html=1;startArrow=diamondThin;startFill=1;startSize=12;endArrow=none;rounded=0;edgeStyle=none;exitX=0.4138;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v21" target="p2v17" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e52" value="" style="html=1;endArrow=block;endFill=0;dashed=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v18" target="p2v11" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e53" value="" style="html=1;startArrow=diamondThin;startFill=1;startSize=12;endArrow=none;rounded=0;edgeStyle=none;exitX=0.5776;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v21" target="p2v18" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e54" value="" style="html=1;endArrow=block;endFill=0;dashed=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v19" target="p2v12" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e55" value="" style="html=1;startArrow=diamondThin;startFill=1;startSize=12;endArrow=none;rounded=0;edgeStyle=none;exitX=0.7414;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v21" target="p2v19" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e56" value="" style="html=1;endArrow=block;endFill=0;dashed=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v20" target="p2v13" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2e57" value="" style="html=1;startArrow=diamondThin;startFill=1;startSize=12;endArrow=none;rounded=0;edgeStyle=none;exitX=0.9052;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" parent="1" source="p2v21" target="p2v20" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2f58" value="" style="html=1;endArrow=open;endFill=1;dashed=1;dashPattern=1 4;edgeStyle=none;exitX=0.7385;exitY=1;exitDx=0;exitDy=0;rounded=0;fontSize=10;" parent="1" source="p2v21" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325" y="838" as="targetPoint" /><Array as="points"><mxPoint x="1325" y="780" /></Array></mxGeometry></mxCell><mxCell id="p2v59" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;Компонент TSL Auth состоит из интерфейсов, которые реализуют шесть прикладных сервисов. Права задаёт матрица каждого приложения; сам TSL Auth управляется матрицей системного приложения &lt;i&gt;tsl-auth-admin&lt;/i&gt; (administrator, auditor, notifier, reset-bot, security-bot, security-officer). Потребители интерфейсов — UI, бэкенды, боты и скрипты с листа «Базовая архитектура». ПДн в БД зашифрованы мастер-ключом, который хранится в OpenBao (secret/tsl-auth) и читается при старте по AppRole." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;size=20;" parent="1" vertex="1"><mxGeometry x="40" y="960" width="1150" height="110" as="geometry" /></mxCell><mxCell id="p2v61" value="&lt;b&gt;Легенда отношений ArchiMate&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;size=20;shape=rect;fillColor=#FFFFFF;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="1220" y="