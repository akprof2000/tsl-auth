@page
@* «Доступ запрещён»: пользователь вошёл, но не имеет прав на страницу; предлагается выйти и войти под другой учётной записью. *@
@{ ViewData["Title"] = L["denied.title"]; }

<div class="card">
    <h2>@L["denied.title"]</h2>
    <p>@L["denied.text"]</p>
    <form method="post" action="/Account/Logout">
        @Html.AntiForgeryToken()
        <button type="submit">@L["denied.switch"]</button>
    </form>
</div>
