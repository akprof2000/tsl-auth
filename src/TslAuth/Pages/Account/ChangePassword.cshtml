@page
@model TslAuth.Pages.Account.ChangePasswordModel
@* Смена пароля; при временном/истёкшем пароле (Forced) показывается предупреждение об обязательной смене. *@
@{
    ViewData["Title"] = L["change.title"];
    ViewData["ReturnUrl"] = Model.ReturnUrl;
}

<div class="card">
    <h2 style="margin-top:0">@L["change.title"]</h2>
    @if (Model.Forced)
    {
        <div class="alert secret">@L["change.forced"]</div>
    }
    <form method="post">
        <partial name="_Errors" />
        <input type="hidden" asp-for="ReturnUrl" />
        <label for="Current">@L["password.current"]</label>
        <input asp-for="Current" autocomplete="current-password" required />
        <partial name="_NewPasswordFields" />
        <div class="actions"><button class="primary" type="submit">@L["change.submit"]</button></div>
    </form>
</div>
