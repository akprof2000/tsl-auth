@page
@model TslAuth.Pages.Account.ForgotPasswordModel
@* Запрос ссылки сброса пароля по e-mail; без настроенной почты форма не показывается. *@
@{
    ViewData["Title"] = L["forgot.title"];
    ViewData["ReturnUrl"] = Model.ReturnUrl;
}

<div class="card">
    <h2>@L["forgot.title"]</h2>
    @if (!Model.EmailAvailable)
    {
        <p>@L["forgot.noEmail"]</p>
    }
    else if (Model.Sent)
    {
        <div class="alert ok">@L["forgot.sent"]</div>
    }
    else
    {
        <partial name="_Errors" />
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label for="Login">@L["login.login"]</label>
            <input asp-for="Login" autofocus required />
            <div class="actions"><button class="primary" type="submit">@L["forgot.submit"]</button></div>
        </form>
    }
    <p class="small"><a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">@L["forgot.back"]</a></p>
</div>
