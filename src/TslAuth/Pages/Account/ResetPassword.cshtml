@page
@model TslAuth.Pages.Account.ResetPasswordModel
@* Установка нового пароля по ссылке из письма; Uid и Token из ссылки передаются скрытыми полями. *@
@{ ViewData["Title"] = L["reset.title"]; }

<div class="card">
    <h2 style="margin-top:0">@L["reset.title"]</h2>
    @if (Model.Done)
    {
        <div class="alert ok">@L["reset.done"]</div>
        <a class="btn primary" asp-page="/Account/Login">@L["login.submit"]</a>
    }
    else
    {
        <form method="post">
            <partial name="_Errors" />
            <input type="hidden" asp-for="Uid" />
            <input type="hidden" asp-for="Token" />
            <partial name="_NewPasswordFields" />
            <div class="actions"><button class="primary" type="submit">@L["reset.submit"]</button></div>
        </form>
    }
</div>
