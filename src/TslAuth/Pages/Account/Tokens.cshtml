@page
@model TslAuth.Pages.Account.TokensModel
@* Персональные токены: выпуск (секрет показывается один раз сразу после создания), список и отзыв.
   Токен для своих скриптов или токен подключения сервиса-робота (обменивает только этот сервис, работает с вашими правами). *@
@{ ViewData["Title"] = L["tokens.title"]; }

<div class="card">
    <h2>@L["tokens.title"]</h2>
    <p class="small muted">@L["tokens.intro"]</p>

    @if (Model.CreatedSecret is not null)
    {
        <div class="alert secret">@L["tokens.created"]<br /><code id="pat-secret">@Model.CreatedSecret</code></div>
    }
    <partial name="_Errors" />

    @if (!Model.Policy.Enabled)
    {
        <p class="muted">@L["tokens.disabled"]</p>
    }
    else if (!Model.CanIssue)
    {
        <p class="muted">@L["error.tokensForbidden"]</p>
    }
    else if (Model.Available.Count == 0)
    {
        <p class="muted">@L["tokens.noApps"]</p>
    }
    else
    {
        <form method="post" asp-page-handler="Create">
            <label for="Name">@L["tokens.name"]</label>
            <input asp-for="Name" placeholder="@L["tokens.namePlaceholder"]" required maxlength="100" />
            @if (Model.Services.Count > 0)
            {
                <fieldset class="plain" id="token-user">
                    <legend>@L["tokens.user"]</legend>
                    <label class="inline"><input type="radio" name="ClientId" value="" checked="@string.IsNullOrEmpty(Model.ClientId)" /> @L["tokens.self"]</label>
                    @foreach (var s in Model.Services)
                    {
                        <label class="inline"><input type="radio" name="ClientId" value="@s.ClientId" checked="@(Model.ClientId == s.ClientId)" /> @s.DisplayName <code class="small">@s.ClientId</code></label>
                    }
                    <p class="small muted">@L["tokens.serviceHint"]</p>
                </fieldset>
            }
            <fieldset class="plain">
                <legend>@L["tokens.apps"]</legend>
                <label class="inline"><input type="checkbox" name="AllApplications" value="true" checked="@Model.AllApplications" /> <strong>@L["tokens.allApps"]</strong></label>
                @foreach (var app in Model.Available)
                {
                    <label class="inline"><input type="checkbox" name="Audiences" value="@app" checked="@Model.Audiences.Contains(app)" /> @app</label>
                }
            </fieldset>
            <label for="ExpiresInDays">@L["tokens.expires"] (≤ @Model.Policy.MaxLifetimeDays)</label>
            <input asp-for="ExpiresInDays" type="number" min="1" max="@Model.Policy.MaxLifetimeDays" />
            <div class="actions"><button class="primary" type="submit">@L["tokens.create"]</button></div>
        </form>
    }
</div>

<div class="card table-wrap">
    @if (Model.Items.Count == 0)
    {
        <p class="muted">@L["tokens.none"]</p>
    }
    else
    {
        <partial name="_PatTable" model="@(new PatTableModel(Model.Items, Admin: false, CanRevoke: true, Handler: "Revoke"))" />
    }
</div>
