@page
@model TslAuth.Pages.Admin.Apps.BrandingModel
@* Оформление страницы входа приложения (тексты, логотип, цвета, язык) и ссылка на предпросмотр; без права изменения поля только для чтения. *@
@{
    ViewData["Title"] = $"Оформление {Model.ClientId}";
    var disabled = !Model.CanManage;
}

<div class="row between">
    <h1>Оформление входа <code>@Model.ClientId</code></h1>
    <div class="row">
        <a class="btn" href="@Model.PreviewUrl" target="_blank" rel="noopener">Предпросмотр ↗</a>
        <a class="btn" asp-page="Edit" asp-route-clientId="@Model.ClientId">← Настройки приложения</a>
    </div>
</div>
<p class="muted">Пользователи, пришедшие на вход из этого приложения (<code>/connect/authorize?client_id=@Model.ClientId</code>),
    увидят страницу входа в его стиле. Пустые поля — оформление по умолчанию.</p>

<form method="post" enctype="multipart/form-data" asp-route-clientId="@Model.ClientId">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="grid2">
        <div class="card">
            <h2>Тексты</h2>
            <label asp-for="Title">Заголовок</label>
            <input asp-for="Title" placeholder="@(Model.DisplayName ?? Model.ClientId)" disabled="@disabled" />
            <label asp-for="WelcomeText">Приветствие</label>
            <textarea asp-for="WelcomeText" placeholder="Войдите, чтобы продолжить работу с заказами" disabled="@disabled"></textarea>
            <label asp-for="FooterText">Подпись внизу</label>
            <input asp-for="FooterText" placeholder="© Отдел продаж, тел. 1234" disabled="@disabled" />
            <label asp-for="DefaultLanguage">Язык страницы входа по умолчанию</label>
            <select asp-for="DefaultLanguage" disabled="@disabled">
                <option value="">по браузеру пользователя</option>
                @foreach (var lang in await L.LanguagesAsync())
                {
                    <option value="@lang.Culture">@lang.Name (@lang.Culture)</option>
                }
            </select>
        </div>
        <div class="card">
            <h2>Логотип и цвета</h2>
            @if (Model.CurrentLogo is not null)
            {
                <div class="brand-preview center"><img src="@Model.CurrentLogo" alt="логотип" class="login-logo" /></div>
                <label class="inline"><input asp-for="RemoveLogo" disabled="@disabled" /> Удалить логотип</label>
            }
            <label asp-for="Logo">Загрузить логотип (PNG/JPEG/WEBP, до 256 КБ)</label>
            <input asp-for="Logo" type="file" accept="image/png,image/jpeg,image/webp" disabled="@disabled" />

            @*
                <input type="color"> не бывает пустым и всегда отправляет значение (#000000 по умолчанию), поэтому цвет
                применяется, только если отмечено «задать»; без отметки — оформление по умолчанию.
            *@
            <div class="grid2">
                <fieldset>
                    <legend>Акцент (кнопки)</legend>
                    <label class="inline"><input asp-for="SetAccentColor" disabled="@disabled" /> задать</label>
                    <input asp-for="AccentColor" type="color" aria-label="Цвет акцента" disabled="@disabled" />
                </fieldset>
                <fieldset>
                    <legend>Фон страницы</legend>
                    <label class="inline"><input asp-for="SetBackgroundColor" disabled="@disabled" /> задать</label>
                    <input asp-for="BackgroundColor" type="color" aria-label="Цвет фона страницы" disabled="@disabled" />
                </fieldset>
                <fieldset>
                    <legend>Фон карточки</legend>
                    <label class="inline"><input asp-for="SetCardColor" disabled="@disabled" /> задать</label>
                    <input asp-for="CardColor" type="color" aria-label="Цвет фона карточки" disabled="@disabled" />
                </fieldset>
                <fieldset>
                    <legend>Текст</legend>
                    <label class="inline"><input asp-for="SetTextColor" disabled="@disabled" /> задать</label>
                    <input asp-for="TextColor" type="color" aria-label="Цвет текста" disabled="@disabled" />
                </fieldset>
            </div>
            <p class="small muted">Снимите отметку «задать», чтобы вернуть цвет по умолчанию.</p>
        </div>
    </div>
    @if (Model.CanManage)
    {
        <div class="actions"><button class="primary" type="submit">Сохранить оформление</button></div>
    }
</form>
