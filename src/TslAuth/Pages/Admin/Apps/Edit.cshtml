@page
@model TslAuth.Pages.Admin.Apps.EditModel
@*
    Регистрация/редактирование приложения: клиент, потоки, флаги App API, redirect URI, scopes, сроки токенов,
    сервисные роли; перевыпуск секрета и удаление. Системное приложение и режим аудитора — только чтение.
*@
@{
    ViewData["Title"] = Model.IsNew ? "Новое приложение" : Model.ClientId;
    var readOnly = !Model.CanManage || Model.IsSystem;
    var grantInfo = new Dictionary<string, string>
    {
        [AppGrantTypes.AuthorizationCode] = "вход пользователя через браузер (OIDC, PKCE)",
        [AppGrantTypes.RefreshToken] = "продление сессии refresh-токеном (scope offline_access)",
        [AppGrantTypes.Password] = "логин/пароль напрямую в /connect/token",
        [AppGrantTypes.ClientCredentials] = "сервис-сервис, токен от имени самого приложения",
        [AppGrantTypes.TokenExchange] = "token exchange (RFC 8693): обменять токен пользователя на токен для другого приложения"
    };
}

<div class="row between">
    <h1>@(Model.IsNew ? "Регистрация приложения" : $"Приложение {Model.ClientId}")</h1>
    @if (!Model.IsNew)
    {
        <div class="row">
            <a class="btn" asp-page="Branding" asp-route-clientId="@Model.ClientId">Оформление входа</a>
            <a class="btn" asp-page="Matrix" asp-route-clientId="@Model.ClientId">Матрица доступа →</a>
        </div>
    }
</div>

@if (Model.Secret is not null)
{
    <div class="alert secret">
        <b>Секрет клиента</b> (показывается один раз, сохраните его сейчас):<br />
        <code>@Model.Secret</code>
    </div>
}
@if (Model.IsSystem)
{
    <div class="alert">Системное приложение: его матрица доступа определяет права администрирования самого сервиса. Настройки клиента изменить нельзя.</div>
}

<form method="post" asp-page-handler="Save" asp-route-clientId="@Model.ClientId">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="grid2">
        <div class="card">
            <h2>Клиент</h2>
            <label>client_id</label>
            @if (Model.IsNew)
            {
                <input asp-for="NewClientId" placeholder="orders-web" required />
                <p class="small muted">Также станет именем scope и audience для обращения к этому приложению как к API.</p>
            }
            else
            {
                <code>@Model.ClientId</code>
            }

            <label asp-for="DisplayName">Название</label>
            <input asp-for="DisplayName" disabled="@readOnly" />

            <label>Тип клиента</label>
            <label class="inline"><input type="radio" asp-for="ClientType" value="confidential" disabled="@readOnly" /> confidential — серверное приложение с секретом</label>
            <label class="inline"><input type="radio" asp-for="ClientType" value="public" disabled="@readOnly" /> public — SPA / мобильное / десктоп (без секрета)</label>

            <label>Разрешённые потоки</label>
            @foreach (var (grant, info) in grantInfo)
            {
                <label class="inline flex">
                    <input type="checkbox" name="GrantTypes" value="@grant" checked="@Model.GrantTypes.Contains(grant)" disabled="@readOnly" />
                    <span><code>@(grant == AppGrantTypes.TokenExchange ? "token_exchange" : grant)</code> <span class="muted small">— @info</span></span>
                </label>
            }

            <label>App API</label>
            <label class="inline flex">
                <input type="checkbox" asp-for="SelfManagement" disabled="@readOnly" />
                <span>Самоуправление — приложение само управляет своими пользователями, ролями и матрицей через
                    <code>/api/app</code> (confidential; client_credentials и scope <code>@SystemApp.AppApiScope</code> включатся автоматически)</span>
            </label>
            <label class="inline flex">
                <input type="checkbox" asp-for="SelfRegistration" disabled="@readOnly" />
                <span>Самостоятельная регистрация — на странице входа появится «Зарегистрироваться»; пользователь запрашивает
                    роли, отмеченные в матрице как «запрашиваемые», и получает их после одобрения</span>
            </label>
        </div>

        <div class="card">
            <h2>Адреса и scopes</h2>
            <label asp-for="RedirectUris">Redirect URIs (по одному в строке)</label>
            <textarea asp-for="RedirectUris" placeholder="https://orders.local/signin-oidc" disabled="@readOnly"></textarea>

            <label asp-for="PostLogoutRedirectUris">Post-logout redirect URIs</label>
            <textarea asp-for="PostLogoutRedirectUris" placeholder="https://orders.local/" disabled="@readOnly"></textarea>

            <label>Разрешённые scopes</label>
            <p class="small muted mt0"><code>openid</code> и <code>offline_access</code> разрешены всегда. Scope другого приложения даёт доступ к его API (audience + права из его матрицы).</p>
            @foreach (var scope in Model.AvailableScopes)
            {
                <label class="inline"><input type="checkbox" name="Scopes" value="@scope" checked="@Model.Scopes.Contains(scope)" disabled="@readOnly" /> @scope</label>
            }
        </div>
    </div>

    @if (!Model.IsSystem)
    {
        <div class="card">
            <h2>Сроки жизни токенов этого приложения</h2>
            <p class="small muted mt0">Пусто — глобальная настройка. Больше глобального значения задать нельзя.</p>
            <div class="grid2">
                <div><label asp-for="AccessTokenMinutes">Access-токен, мин (глобально @Model.GlobalTokens.AccessTokenMinutes)</label>
                    <input asp-for="AccessTokenMinutes" type="number" min="1" max="@Model.GlobalTokens.AccessTokenMinutes" disabled="@readOnly" /></div>
                <div><label asp-for="RefreshTokenDays">Refresh-токен, дней (глобально @Model.GlobalTokens.RefreshTokenDays)</label>
                    <input asp-for="RefreshTokenDays" type="number" min="1" max="@Model.GlobalTokens.RefreshTokenDays" disabled="@readOnly" /></div>
                <div><label asp-for="ExchangeTokenMinutes">Token exchange, мин (глобально @Model.GlobalTokens.ExchangeTokenMinutes)</label>
                    <input asp-for="ExchangeTokenMinutes" type="number" min="1" max="@Model.GlobalTokens.ExchangeTokenMinutes" disabled="@readOnly" /></div>
            </div>
        </div>
        <div class="card">
            <h2>Роли сервисной учётной записи</h2>
            <p class="small muted">Используются при <code>client_credentials</code>: какие роли в каких приложениях есть у самого клиента.</p>
            <partial name="_RoleCheckboxes" model="@(("ServiceRoles", Model.AllRoles, Model.ServiceRoles, readOnly))" />
        </div>
    }

    @if (!readOnly)
    {
        <div class="actions">
            <button class="primary" type="submit">@(Model.IsNew ? "Зарегистрировать" : "Сохранить")</button>
            <a class="btn" asp-page="Index">Отмена</a>
        </div>
    }
</form>

@if (!Model.IsNew && !readOnly)
{
    <div class="actions">
        @if (Model.ClientType == "confidential")
        {
            <form method="post" asp-page-handler="Secret" asp-route-clientId="@Model.ClientId" class="inline"
                  data-confirm="Перевыпустить секрет? Текущий секрет перестанет работать.">
                <button type="submit">Перевыпустить секрет</button>
            </form>
        }
        <form method="post" asp-page-handler="Delete" asp-route-clientId="@Model.ClientId" class="inline"
              data-confirm="Удалить приложение, его матрицу доступа и все сессии?">
            <button class="danger" type="submit">Удалить приложение</button>
        </form>
    </div>
}
