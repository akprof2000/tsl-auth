@page
@model TslAuth.Pages.Admin.Apps.EditModel
@*
    Регистрация/редактирование приложения: клиент, потоки, флаги App API, redirect URI, scopes, сроки токенов,
    сервисные роли; перевыпуск секрета и удаление. Системное приложение и режим аудитора — только чтение.
*@
@{
    ViewData["Title"] = Model.IsNew ? "Новое приложение" : Model.ClientId;
    var readOnly = !Model.CanManage || Model.IsSystem || Model.IsManaged;
    var grantInfo = new Dictionary<string, string>
    {
        [AppGrantTypes.AuthorizationCode] = "вход пользователя через браузер (OIDC, PKCE)",
        [AppGrantTypes.RefreshToken] = "продление сессии refresh-токеном (scope offline_access)",
        [AppGrantTypes.Password] = "логин/пароль напрямую в /connect/token",
        [AppGrantTypes.ClientCredentials] = "сервис-сервис, токен от имени самого приложения",
        [AppGrantTypes.TokenExchange] = "token exchange (RFC 8693): обменять токен пользователя на токен для другого приложения"
    };
}

<div class="row between">
    <h1>@(Model.IsNew ? "Регистрация приложения" : $"Приложение {Model.ClientId}")</h1>
    @if (!Model.IsNew)
    {
        <div class="row">
            <a class="btn" asp-page="Branding" asp-route-clientId="@Model.ClientId">Оформление входа</a>
            <a class="btn" asp-page="Matrix" asp-route-clientId="@Model.ClientId">Матрица доступа →</a>
        </div>
    }
</div>

@if (Model.Secret is not null)
{
    <div class="alert secret">
        <b>Секрет клиента</b> (показывается один раз, сохраните его сейчас):<br />
        <code>@Model.Secret</code>
    </div>
}
@if (Model.IsSystem)
{
    <div class="alert">Системное приложение: его матрица доступа определяет права администрирования самого сервиса. Настройки клиента изменить нельзя.</div>
}
@if (Model.IsManaged)
{
    <div class="alert">Подчинённый клиент приложения <a asp-page="Edit" asp-route-clientId="@Model.Owner"><code>@Model.Owner</code></a>:
        его ключи, роли и секрет задаёт владелец через App API (<code>/api/app/clients</code>). Здесь доступны отключение и удаление.</div>
}
@if (Model.Disabled)
{
    <div class="alert error">Клиент отключён: токены не выдаются, выданные отозваны.</div>
}

<form method="post" asp-page-handler="Save" asp-route-clientId="@Model.ClientId">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="grid2">
        <div class="card">
            <h2>Клиент</h2>
            @if (Model.IsNew)
            {
                <label asp-for="NewClientId">client_id</label>
                <input asp-for="NewClientId" placeholder="orders-web" required />
                <p class="small muted">Также станет именем scope и audience для обращения к этому приложению как к API.</p>
            }
            else
            {
                <div class="field-title">client_id</div>
                <code>@Model.ClientId</code>
            }

            <label asp-for="DisplayName">Название</label>
            <input asp-for="DisplayName" disabled="@readOnly" />

            <fieldset class="plain">
                <legend>Тип клиента</legend>
                <label class="inline"><input type="radio" asp-for="ClientType" id="ClientType-confidential" value="confidential" disabled="@readOnly" /> confidential — серверное приложение с секретом</label>
                <label class="inline"><input type="radio" asp-for="ClientType" id="ClientType-public" value="public" disabled="@readOnly" /> public — SPA / мобильное / десктоп (без секрета)</label>
            </fieldset>

            <fieldset class="plain">
                <legend>Разрешённые потоки</legend>
                @foreach (var (grant, info) in grantInfo)
                {
                    <label class="inline flex">
                        <input type="checkbox" name="GrantTypes" value="@grant" checked="@Model.GrantTypes.Contains(grant)" disabled="@readOnly" />
                        <span><code>@(grant == AppGrantTypes.TokenExchange ? "token_exchange" : grant)</code> <span class="muted small">— @info</span></span>
                    </label>
                }
            </fieldset>

            <fieldset class="plain">
            <legend>App API</legend>
            <label class="inline flex">
                <input type="checkbox" asp-for="SelfManagement" disabled="@readOnly" />
                <span>Самоуправление — приложение само управляет своими пользователями, ролями и матрицей через
                    <code>/api/app</code> (confidential; client_credentials и scope <code>@SystemApp.AppApiScope</code> включатся автоматически)</span>
            </label>
            <label class="inline flex">
                <input type="checkbox" asp-for="SelfRegistration" disabled="@readOnly" />
                <span>Самостоятельная регистрация — на странице входа появится «Зарегистрироваться»; пользователь запрашивает
                    роли, отмеченные в матрице как «запрашиваемые», и получает их после одобрения</span>
            </label>
            </fieldset>
        </div>

        <div class="card">
            <h2>Адреса и scopes</h2>
            <label asp-for="RedirectUris">Redirect URIs (по одному в строке)</label>
            <textarea asp-for="RedirectUris" placeholder="https://orders.local/signin-oidc" disabled="@readOnly"></textarea>

            <label asp-for="PostLogoutRedirectUris">Post-logout redirect URIs</label>
            <textarea asp-for="PostLogoutRedirectUris" placeholder="https://orders.local/" disabled="@readOnly"></textarea>

            <fieldset class="plain">
                <legend>Разрешённые scopes</legend>
                <p class="small muted mt0"><code>openid</code> и <code>offline_access</code> разрешены всегда. Scope другого приложения даёт доступ к его API (audience + права из его матрицы).</p>
                @foreach (var scope in Model.AvailableScopes)
                {
                    <label class="inline"><input type="checkbox" name="Scopes" value="@scope" checked="@Model.Scopes.Contains(scope)" disabled="@readOnly" /> @scope</label>
                }
            </fieldset>
        </div>
    </div>

    @if (!Model.IsSystem)
    {
        <div class="card">
            <h2>Сроки жизни токенов этого приложения</h2>
            <p class="small muted mt0">Пусто — глобальная настройка. Больше глобального значения задать нельзя.</p>
            <div class="grid2">
                <div><label asp-for="AccessTokenMinutes">Access-токен, мин (глобально @Model.GlobalTokens.AccessTokenMinutes)</label>
                    <input asp-for="AccessTokenMinutes" type="number" min="1" max="@Model.GlobalTokens.AccessTokenMinutes" disabled="@readOnly" /></div>
                <div><label asp-for="RefreshTokenDays">Refresh-токен, дней (глобально @Model.GlobalTokens.RefreshTokenDays)</label>
                    <input asp-for="RefreshTokenDays" type="number" min="1" max="@Model.GlobalTokens.RefreshTokenDays" disabled="@readOnly" /></div>
                <div><label asp-for="ExchangeTokenMinutes">Token exchange, мин (глобально @Model.GlobalTokens.ExchangeTokenMinutes)</label>
                    <input asp-for="ExchangeTokenMinutes" type="number" min="1" max="@Model.GlobalTokens.ExchangeTokenMinutes" disabled="@readOnly" /></div>
            </div>
        </div>
        <div class="card">
            <h2>Роли сервисной учётной записи</h2>
            <p class="small muted">Используются при <code>client_credentials</code>: какие роли в каких приложениях есть у самого клиента.</p>
            <partial name="_RoleCheckboxes" model="@(("ServiceRoles", Model.AllRoles, Model.ServiceRoles, readOnly))" />
        </div>
    }

    @if (!readOnly)
    {
        <div class="actions">
            <button class="primary" type="submit">@(Model.IsNew ? "Зарегистрировать" : "Сохранить")</button>
            <a class="btn" asp-page="Index">Отмена</a>
        </div>
    }
</form>

@if (!Model.IsNew && !Model.IsSystem && Model.CanManage && Model.Owner is null)
{
    <div class="card">
        <h2>Подчинённые клиенты</h2>
        <p class="small muted mt0">Приложение-владелец через App API (<code>/api/app/clients</code>) заводит сервисных клиентов в рамках этой
            политики: префикс <code>client_id</code>, роли только из белого списка своих ролей, поток <code>client_credentials</code>,
            вход по ключу (<code>private_key_jwt</code>, ES256) и/или секрету. Требует confidential-клиента с самоуправлением.</p>
        <form method="post" asp-page-handler="Policy" asp-route-clientId="@Model.ClientId">
            <label class="inline flex"><input type="checkbox" asp-for="PolicyEnabled" /> <span>Разрешить подчинённых клиентов</span></label>
            <div class="grid2">
                <div><label asp-for="PolicyPrefix">Префикс client_id</label><input asp-for="PolicyPrefix" placeholder="import-agent-" /></div>
                <div><label asp-for="PolicyManagePermission">Разрешение оператора (в матрице этого приложения)</label><input asp-for="PolicyManagePermission" /></div>
                <div><label asp-for="PolicyMaxClients">Предел числа подчинённых</label><input asp-for="PolicyMaxClients" type="number" min="1" max="10000" /></div>
                <div><label asp-for="PolicyAccessTokenLifetime">Access-токен подчинённых, мин</label><input asp-for="PolicyAccessTokenLifetime" type="number" min="1" max="1440" /></div>
                <div><label asp-for="PolicyInactiveDays">Автоотключение без токенов, дней (0 — выкл.)</label><input asp-for="PolicyInactiveDays" type="number" min="0" max="3650" /></div>
            </div>
            <fieldset class="plain">
                <legend>Способы входа подчинённых</legend>
                <label class="inline"><input type="checkbox" name="PolicyAuthMethods" value="@ManagedClientsPolicy.PrivateKeyJwt" checked="@Model.PolicyAuthMethods.Contains(ManagedClientsPolicy.PrivateKeyJwt)" /> <code>private_key_jwt</code> — по ключу ES256, без секрета</label>
                <label class="inline"><input type="checkbox" name="PolicyAuthMethods" value="@ManagedClientsPolicy.ClientSecret" checked="@Model.PolicyAuthMethods.Contains(ManagedClientsPolicy.ClientSecret)" /> <code>client_secret</code> — по секрету</label>
            </fieldset>
            <label class="inline flex"><input type="checkbox" asp-for="PolicyRequireDelegation" />
                <span>Изменения только делегированным токеном оператора (token exchange); выключено — допускается и сервисный токен владельца (тестовые стенды)</span></label>
            <fieldset class="plain">
                <legend>Роли, которые можно выдавать подчинённым (белый список)</legend>
                @if (Model.OwnRoles.Count == 0) { <p class="muted small">Ролей пока нет — создайте их в матрице доступа.</p> }
                @foreach (var role in Model.OwnRoles)
                {
                    <label class="inline"><input type="checkbox" name="PolicyRoles" value="@role.Role" checked="@Model.PolicyRoles.Contains(role.Role)" /> @(role.DisplayName ?? role.Role) <code class="small">@role.Role</code></label>
                }
            </fieldset>
            <div class="actions"><button class="primary" type="submit">Сохранить политику</button></div>
        </form>

        @if (Model.ManagedClients.Count > 0)
        {
            <div class="table-wrap">
                <table class="managed-clients">
                    <thead><tr><th>client_id</th><th>Название</th><th>Роли</th><th>Ключи (kid)</th><th>Последний токен</th><th>Статус</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.ManagedClients)
                    {
                        <tr>
                            <td><a asp-page="Edit" asp-route-clientId="@c.ClientId"><code>@c.ClientId</code></a></td>
                            <td>@c.DisplayName</td>
                            <td>@foreach (var r in c.Roles) { <span class="badge">@r</span> }</td>
                            <td>@foreach (var k in c.Keys) { <code class="small">@k.Kid</code><br /> } @if (c.HasSecret) { <span class="badge">секрет</span> }</td>
                            <td>@(c.LastTokenIssuedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>@if (c.Disabled) { <span class="badge warn">отключён</span> } else { <span class="badge ok">активен</span> }</td>
                            <td class="row">
                                <form method="post" asp-page-handler="Toggle" asp-route-clientId="@Model.ClientId" asp-route-target="@c.ClientId" asp-route-disabled="@(!c.Disabled)" class="inline">
                                    <button type="submit">@(c.Disabled ? "Включить" : "Отключить")</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteManaged" asp-route-clientId="@Model.ClientId" asp-route-target="@c.ClientId" class="inline"
                                      data-confirm="Удалить подчинённого клиента @c.ClientId с отзывом его токенов?">
                                    <button class="danger" type="submit">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (!Model.IsNew && !Model.IsSystem && Model.CanManage)
{
    <div class="actions">
        <form method="post" asp-page-handler="Toggle" asp-route-clientId="@Model.ClientId" asp-route-disabled="@(!Model.Disabled)" class="inline"
              data-confirm="@(Model.Disabled ? "Включить клиента?" : "Отключить клиента? Его токены будут отозваны.")">
            <button type="submit">@(Model.Disabled ? "Включить клиента" : "Отключить клиента")</button>
        </form>
        @if (Model.IsManaged)
        {
            <form method="post" asp-page-handler="Delete" asp-route-clientId="@Model.ClientId" class="inline"
                  data-confirm="Удалить подчинённого клиента и отозвать его токены?">
                <button class="danger" type="submit">Удалить клиента</button>
            </form>
        }
    </div>
}

@if (!Model.IsNew && !readOnly)
{
    <div class="actions">
        @if (Model.ClientType == "confidential")
        {
            <form method="post" asp-page-handler="Secret" asp-route-clientId="@Model.ClientId" class="inline"
                  data-confirm="Перевыпустить секрет? Текущий секрет перестанет работать.">
                <button type="submit">Перевыпустить секрет</button>
            </form>
        }
        <form method="post" asp-page-handler="Delete" asp-route-clientId="@Model.ClientId" class="inline"
              data-confirm="Удалить приложение, его матрицу доступа и все сессии?">
            <button class="danger" type="submit">Удалить приложение</button>
        </form>
    </div>
}
