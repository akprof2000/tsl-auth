@page
@model TslAuth.Pages.Admin.Audit.IndexModel
@using TslAuth.Data
@*
    Журнал безопасности: фильтры (тип или группа "префикс.*", уровень, результат, приложение, пользователь, период),
    выгрузка CSV с теми же фильтрами и переход к более ранним записям через BeforeId.
*@
@{
    ViewData["Title"] = "Журнал безопасности";
    var query = ViewContext.HttpContext.Request.Query.Where(q => q.Key != "BeforeId" && q.Key != "handler")
        .ToDictionary(q => q.Key, q => q.Value.ToString());
}

<div class="row between">
    <h1>Журнал безопасности</h1>
    <a class="btn" asp-page="Index" asp-page-handler="Csv" asp-all-route-data="query">Выгрузить CSV (до 1000 строк)</a>
</div>

<form method="get" class="card row">
    <select name="Type" style="max-width:220px">
        <option value="">все типы</option>
        @foreach (var group in Model.Types.Select(t => t.Split('.')[0] + ".").Distinct())
        {
            <option value="@group" selected="@(Model.Type == group)">@group* (группа)</option>
        }
        @foreach (var t in Model.Types)
        {
            <option value="@t" selected="@(Model.Type == t)">@t</option>
        }
    </select>
    <select name="MinSeverity" style="max-width:160px">
        <option value="">любой уровень</option>
        <option value="Warning" selected="@(Model.MinSeverity == AuditSeverity.Warning)">warning+</option>
        <option value="Critical" selected="@(Model.MinSeverity == AuditSeverity.Critical)">critical</option>
    </select>
    <select name="Success" style="max-width:150px">
        <option value="">любой результат</option>
        <option value="true" selected="@(Model.Success == true)">успешно</option>
        <option value="false" selected="@(Model.Success == false)">неуспешно</option>
    </select>
    <input name="ClientId" value="@Model.ClientId" placeholder="client_id" style="max-width:160px" />
    <input name="UserId" value="@Model.UserId" placeholder="id пользователя" style="max-width:300px" />
    <input name="From" type="datetime-local" value="@Model.From?.ToString("yyyy-MM-ddTHH:mm")" style="max-width:200px" />
    <input name="To" type="datetime-local" value="@Model.To?.ToString("yyyy-MM-ddTHH:mm")" style="max-width:200px" />
    <button class="primary" type="submit">Показать</button>
    <a asp-page="Index">Сбросить</a>
</form>

<div class="table-wrap">
    <table>
        <thead><tr><th>Время</th><th>Событие</th><th>Кто</th><th>Приложение</th><th>IP / экземпляр</th><th>Детали</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Items)
        {
            <tr>
                <td class="small">@e.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>
                    <code>@e.Type</code>
                    <div>
                        <span class="badge @(e.Success ? "ok" : "danger")">@(e.Success ? "успех" : "отказ")</span>
                        @if (e.Severity != "info") { <span class="badge @(e.Severity == "critical" ? "danger" : "warn")">@e.Severity</span> }
                    </div>
                </td>
                <td class="small">
                    @(e.ActorName ?? e.Actor)
                    @if (e.SubjectUserId is { } uid) { <div><a asp-page="/Admin/Users/Edit" asp-route-id="@uid">пользователь</a></div> }
                </td>
                <td><code>@e.ClientId</code></td>
                <td class="small">@e.Ip<div class="muted">@e.Instance</div></td>
                <td class="small"><code style="white-space:pre-wrap">@e.Details?.GetRawText()</code></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Items.Count == IndexModel.PageSize)
{
    var next = new Dictionary<string, string>(query) { ["BeforeId"] = Model.Items[^1].Id.ToString() };
    <div class="actions"><a class="btn" asp-page="Index" asp-all-route-data="next">Более ранние →</a></div>
}
