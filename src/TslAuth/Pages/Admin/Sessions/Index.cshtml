@page
@model TslAuth.Pages.Admin.Sessions.IndexModel
@* Активные сессии (авторизации OpenIddict) с фильтром по client_id; кнопка отзыва — только при праве на изменения. *@
@{ ViewData["Title"] = "Сессии"; }

<h1>Активные сессии <span class="muted small">(@Model.Items.Count)</span></h1>
<p class="muted small">
    Сессии и refresh-токены хранятся в БД: они не теряются при перезапуске и доступны любому экземпляру сервиса.
</p>

<form method="get" class="row mb16">
    <label for="session-client" class="visually-hidden">Фильтр по client_id</label>
    <input id="session-client" name="ClientId" value="@Model.ClientId" placeholder="Фильтр по client_id" class="w-lg" />
    <button type="submit">Показать</button>
</form>

<div class="table-wrap">
    <partial name="_SessionTable" model="@(new SessionTableModel(Model.Items, ShowSubject: true, CanRevoke: Model.CanManage, ClientIdFilter: Model.ClientId))" />
</div>
