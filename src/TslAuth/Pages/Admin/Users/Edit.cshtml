@page
@model TslAuth.Pages.Admin.Users.EditModel
@*
    Карточка пользователя: профиль, способ онбординга (для нового), роли, действия с паролем и доступом,
    активные сессии и персональные токены. Одноразовый пароль/ссылка-приглашение показываются один раз (из TempData).
*@
@{
    ViewData["Title"] = Model.IsNew ? "Новый пользователь" : Model.UserName;
    var readOnly = !Model.CanManage;
}

<h1>@(Model.IsNew ? "Новый пользователь" : $"Пользователь {Model.Current!.UserName}")</h1>

@if (Model.OneTimePassword is not null)
{
    <div class="alert secret">
        <b>Временный пароль</b> (показывается один раз; при первом входе пользователь обязан его сменить):<br />
        <code>@Model.OneTimePassword</code>
    </div>
}
@if (Model.InviteLink is not null)
{
    <div class="alert secret">
        <b>Ссылка-приглашение</b> (одноразовая, действует 7 дней):<br />
        <code>@Model.InviteLink</code>
    </div>
}

<form method="post" asp-page-handler="Save" asp-route-id="@Model.Id">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="grid2">
        <div class="card">
            <h2>Профиль</h2>
            <label asp-for="UserName">Логин</label>
            <input asp-for="UserName" required disabled="@readOnly" />
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" disabled="@readOnly" />
            <label asp-for="DisplayName">Отображаемое имя</label>
            <input asp-for="DisplayName" disabled="@readOnly" />
            <label class="inline"><input asp-for="IsActive" disabled="@readOnly" /> Активен (при отключении все сессии отзываются)</label>

            @if (Model.IsNew)
            {
                <fieldset>
                    <legend>Как пользователь получит доступ</legend>
                    <label class="inline flex"><input type="radio" name="Onboarding" value="invite" checked="@(Model.Onboarding == "invite")" />
                        <span>Приглашение — пользователь сам задаст пароль по ссылке@(Model.EmailConfigured ? " (отправим на email)" : " (ссылку нужно передать вручную)")</span></label>
                    <label class="inline flex"><input type="radio" name="Onboarding" value="temporary" checked="@(Model.Onboarding == "temporary")" />
                        <span>Одноразовый пароль — будет сгенерирован и показан вам, при первом входе потребуется сменить</span></label>
                    <label class="inline flex"><input type="radio" name="Onboarding" value="password" checked="@(Model.Onboarding == "password")" />
                        <span>Задать постоянный пароль:</span></label>
                    <input asp-for="Password" type="password" autocomplete="new-password" placeholder="только для варианта «постоянный пароль»"
                           aria-label="Постоянный пароль" />
                </fieldset>
            }
            else
            {
                <p class="small muted">
                    Создан: @Ui.Time(Model.Current!.CreatedAt),
                    последний вход: @Ui.Time(Model.Current.LastLoginAt, "—").
                    @if (!Model.Current.HasPassword) { <span class="badge warn">ожидает приглашения</span> }
                    @if (Model.Current.MustChangePassword) { <span class="badge warn">временный пароль</span> }
                    @if (Model.Current.IsLockedOut) { <span class="badge danger">заблокирован после неудачных попыток</span> }
                </p>
            }
        </div>

        <div class="card">
            <h2>Роли в приложениях</h2>
            <partial name="_RoleCheckboxes" model="@(("Roles", Model.AllRoles, Model.Roles, readOnly))" />
        </div>
    </div>

    @if (!readOnly)
    {
        <div class="actions">
            <button class="primary" type="submit">@(Model.IsNew ? "Создать" : "Сохранить")</button>
            <a class="btn" asp-page="Index">Отмена</a>
        </div>
    }
</form>

@if (!Model.IsNew && !readOnly)
{
    <h2>Пароль и доступ</h2>
    <div class="card">
        <div class="row">
            <form method="post" asp-page-handler="TemporaryPassword" asp-route-id="@Model.Id" class="inline"
                  data-confirm="Сгенерировать новый временный пароль? Текущий пароль и все сессии будут сброшены.">
                <button type="submit">Выдать временный пароль</button>
            </form>
            <form method="post" asp-page-handler="ResetEmail" asp-route-id="@Model.Id" class="inline">
                <button type="submit" disabled="@(!Model.EmailConfigured || Model.Current!.Email is null)">Отправить ссылку сброса на email</button>
            </form>
            <form method="post" asp-page-handler="Invite" asp-route-id="@Model.Id" class="inline">
                <button type="submit">@(Model.Current!.HasPassword ? "Повторно пригласить" : "Выслать приглашение")</button>
            </form>
            @if (Model.Current!.IsLockedOut)
            {
                <form method="post" asp-page-handler="Unlock" asp-route-id="@Model.Id" class="inline"><button type="submit">Разблокировать</button></form>
            }
        </div>
        @if (!Model.EmailConfigured)
        {
            <p class="small muted">SMTP не настроен: приглашение показывается ссылкой на этой странице, сброс по email недоступен.</p>
        }
    </div>
}

@if (!Model.IsNew)
{
    <h2>Активные сессии (@Model.Sessions.Count)</h2>
    <div class="table-wrap">
        <partial name="_SessionTable" model="@(new SessionTableModel(Model.Sessions, ShowSubject: false, CanRevoke: false))" />
    </div>
    <h2>Персональные токены (@Model.Tokens.Count(t => t.IsActive) активных)</h2>
    <div class="table-wrap">
        <partial name="_PatTable" model="@(new PatTableModel(Model.Tokens, Admin: true, CanRevoke: !readOnly, Handler: "RevokeToken", RouteId: Model.Id))" />
    </div>
    @if (!readOnly)
    {
        <div class="actions">
            @if (Model.Sessions.Count > 0)
            {
                <form method="post" asp-page-handler="RevokeSessions" asp-route-id="@Model.Id" class="inline">
                    <button type="submit">Завершить все сессии</button>
                </form>
            }
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="inline"
                  data-confirm="Удалить пользователя безвозвратно?">
                <button class="danger" type="submit">Удалить пользователя</button>
            </form>
        </div>
    }
}
