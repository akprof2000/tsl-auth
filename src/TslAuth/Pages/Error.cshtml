@page
@model TslAuth.Pages.ErrorModel
@*
    Страница необработанной ошибки: без подробностей исключения, только идентификатор для поиска в журнале.
    Собственный минимальный макет без обращений к БД (общий _Layout читает брендинг, языки и заявки) —
    страница должна открыться и тогда, когда ошибка вызвана недоступностью БД.
*@
@{ Layout = null; }
<!DOCTYPE html>
<html lang="@(Model.English ? "en" : "ru")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Model.English ? "Error" : "Ошибка") — TSL Auth</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<main class="narrow">
    <div class="card">
        @if (Model.English)
        {
            <h2>An error occurred</h2>
            <p>The request could not be processed. Details are in the service log (request id: <code>@Model.RequestId</code>).</p>
            <a href="/">Go to the home page</a>
        }
        else
        {
            <h2>Произошла ошибка</h2>
            <p>Запрос не удалось обработать. Подробности — в журнале сервиса (идентификатор: <code>@Model.RequestId</code>).</p>
            <a href="/">На главную</a>
        }
    </div>
</main>
</body>
</html>
