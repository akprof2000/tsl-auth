@* Поля "новый пароль / подтверждение". Модель страницы должна иметь свойства Password и Confirm. Ошибки выводит _Errors. *@
@inject SettingsService Settings
@{ var policy = (await Settings.GetAsync()).Passwords; }
<label for="Password">@L["password.new"]</label>
<input id="Password" name="Password" type="password" autocomplete="new-password" required minlength="@policy.MinLength" />

<label for="Confirm">@L["password.confirm"]</label>
<input id="Confirm" name="Confirm" type="password" autocomplete="new-password" required />

<p class="small muted">@L["password.requirements"]: @L.PasswordPolicy(policy)</p>
