@*
    Чекбоксы запрашиваемых ролей (регистрация и «Запрос доступа»): название роли для пользователей, приложение,
    описание. Значение — "client_id|роль". Уже выданные роли отмечены и недоступны.
*@
@model RequestableRolesModel
@foreach (var role in Model.Roles)
{
    var has = Model.Assigned.Contains(role.Key);
    <label class="inline flex">
        <input type="checkbox" name="Roles" value="@role.Key" checked="@(has || Model.Selected.Contains(role.Key))" disabled="@has" />
        <span><b>@role.Title</b> <span class="badge">@role.AppTitle</span>@if (has) { <text> @L["request.already"]</text> }
            @if (role.Description is not null) { <span class="muted small">— @role.Description</span> }</span>
    </label>
}
