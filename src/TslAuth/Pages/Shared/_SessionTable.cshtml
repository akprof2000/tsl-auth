@*
    Таблица OIDC-сессий в админке: общий список (/Admin/Sessions — со столбцом субъекта и отзывом)
    и карточка пользователя (только его сессии, без отзыва по одной).
*@
@model SessionTableModel
<table>
    <thead><tr>
        @if (Model.ShowSubject) { <th>Субъект</th> }
        <th>Приложение</th><th>Тип</th><th>Начата</th><th>Последняя выдача токена</th><th>Токенов</th>
        @if (Model.CanRevoke) { <th></th> }
    </tr></thead>
    <tbody>
    @foreach (var s in Model.Items)
    {
        <tr>
            @if (Model.ShowSubject)
            {
                <td>
                    @if (s.UserName is not null && Guid.TryParse(s.Subject, out var uid))
                    {
                        <a asp-page="/Admin/Users/Edit" asp-route-id="@uid">@s.UserName</a>
                    }
                    else
                    {
                        <code>@s.Subject</code>
                    }
                </td>
            }
            <td><code>@s.ClientId</code></td>
            <td>@s.Type</td>
            <td class="small">@Ui.Time(s.CreatedAt)</td>
            <td class="small">@Ui.Time(s.LastTokenIssuedAt)</td>
            <td>@s.ActiveTokens</td>
            @if (Model.CanRevoke)
            {
                <td>
                    <form method="post" asp-page-handler="Revoke" asp-route-clientId="@Model.ClientIdFilter" class="inline">
                        <input type="hidden" name="sessionId" value="@s.Id" />
                        <button class="danger" type="submit">Отозвать</button>
                    </form>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
