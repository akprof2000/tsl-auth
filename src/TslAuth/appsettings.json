{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/tsl-auth.db"
  },

  "Encryption": {
    "MasterKey": "",
    "MasterKeyFile": ""
  },

  "Auth": {
    "Issuer": "",
    "RequireHttps": true,
    "TrustForwardedHeaders": false,
    "AccessTokenLifetimeMinutes": 15,
    "IdentityTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14,
    "AuthorizationCodeLifetimeMinutes": 5
  },

  "Bootstrap": {
    "AdminUserName": "admin",
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminApiClientId": "",
    "AdminApiClientSecret": ""
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTlsWhenAvailable",
    "UserName": "",
    "Password": "",
    "From": "TSL Auth <no-reply@tsl.local>"
  }
}
