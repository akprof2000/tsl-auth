{
  "Logging": {
    "Format": "Text",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning",
      "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/tsl-auth.db"
  },

  "Encryption": {
    "MasterKey": "",
    "MasterKeyFile": ""
  },

  "Auth": {
    "Issuer": "",
    "RequireHttps": true,
    "TrustForwardedHeaders": false,
    "AccessTokenLifetimeMinutes": 15,
    "IdentityTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14,
    "AuthorizationCodeLifetimeMinutes": 5
  },

  "Bootstrap": {
    "AdminUserName": "admin",
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminApiClientId": "",
    "AdminApiClientSecret": ""
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTlsWhenAvailable",
    "UserName": "",
    "Password": "",
    "From": "TSL Auth <no-reply@tsl.local>"
  },

  "Observability": {
    "ServiceName": "tsl-auth",
    "InstanceId": "",
    "ResourceAttributes": "",
    "Prometheus": {
      "Enabled": false,
      "Path": "/metrics",
      "AllowedNetworks": "",
      "Token": "",
      "TokenFile": ""
    },
    "OpenTelemetry": {
      "Endpoint": "",
      "Protocol": "grpc",
      "Headers": "",
      "HeadersFile": "",
      "Traces": true,
      "Metrics": true,
      "Logs": true,
      "TraceSamplingRatio": 1.0,
      "MetricsExportIntervalSeconds": 30
    },
    "Loki": {
      "Url": "",
      "Labels": "",
      "Tenant": "",
      "Username": "",
      "Password": "",
      "PasswordFile": "",
      "MinimumLevel": "Information",
      "BatchSize": 500,
      "PeriodSeconds": 2,
      "QueueLimit": 10000
    }
  }
}
